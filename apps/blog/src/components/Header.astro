---
// Navegação principal. `Astro.url.pathname` nos permite marcar
// o link da página atual com aria-current para acessibilidade.
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../lib/paths';

const pathname = Astro.url.pathname;

// O site vive sob um subcaminho (base path); removemos esse prefixo
// do pathname para comparar com os links da navegação.
const currentPath = pathname.replace(import.meta.env.BASE_URL, '');

// O site vive em pastas (apps/blog), o header precisa listar
// as seções principais do arquivo.
const links = [
  { href: withBase('/'), label: 'Início' },
  { href: withBase('/posts'), label: 'Posts' },
  { href: withBase('/projects'), label: 'Projetos' },
  { href: withBase('/notes'), label: 'Notas' },
  { href: withBase('/archive'), label: 'Arquivo' },
  { href: withBase('/about'), label: 'Sobre' },
];

function isCurrent(link: string) {
  const target = link.replace(import.meta.env.BASE_URL, '');
  if (target === '/') return currentPath === '/';
  return currentPath.startsWith(target);
}
---

<header class="site-header">
  <nav class="container" aria-label="Navegação principal">
    <p class="brand"><a href={withBase('/')}>arquivo</a></p>
    <ul class="nav-links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>

<script>
  // Não é necessário lógica extra aqui — o ThemeToggle tem o próprio script.
</script>