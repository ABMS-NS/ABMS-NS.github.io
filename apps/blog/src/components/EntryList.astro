---
// Componente reutilizável para listar posts do arquivo.
//
// O link de cada item aponta para a página do post
// (`/posts/<slug>`) e mostra a data de publicação.
import type { CollectionEntry } from 'astro:content';
import { shortDate } from '../lib/format';
import { withBase } from '../lib/paths';

type PostEntry = CollectionEntry<'posts'>;

interface Props {
  entries: PostEntry[];
  showTags?: boolean;
}

const { entries, showTags = false } = Astro.props;
---

<ul class="entry-list">
  {
    entries.map((entry) => (
      <li class="entry">
        <div class="entry-content">
          <a href={withBase(`/posts/${entry.id}`)}>{entry.data.title}</a>
          {entry.data.description ? (
            <p class="entry-description">{entry.data.description}</p>
          ) : null}
        </div>
        {
          showTags ? (
            <span class="entry-meta">{entry.data.tags.join(', ')}</span>
          ) : (
            <time datetime={entry.data.pubDate.toISOString()}>
              {shortDate.format(entry.data.pubDate)}
            </time>
          )
        }
      </li>
    ))
  }
</ul>

<style>
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entry-content {
    min-width: 0;
    flex: 1;
  }

  .entry-description {
    margin: 0.2rem 0 0;
    max-width: 72ch;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    line-height: 1.45;
    font-weight: 400;
  }
</style>