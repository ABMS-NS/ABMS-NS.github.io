---
// Botão que alterna entre tema claro e escuro.
// O estado é persistido em localStorage; o script `is:inline` do
// layout já aplicou o tema antes do primeiro paint, então aqui
// apenas sincronizamos a visualização do botão.
const labels = {
  dark: 'Ativar tema escuro',
  light: 'Ativar tema claro',
};
---

<button
  class="theme-toggle"
  type="button"
  aria-label={labels.dark}
  title={labels.dark}
  data-theme-toggle
>
  <!-- Sol (visível no tema escuro) -->
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
  <!-- Lua (visível no tema claro) -->
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  const button = document.querySelector('[data-theme-toggle]');

  // Lê o tema atualmente aplicado (definido pelo script no <head>)
  // e sincroniza rótulo e ícones.
  function sync(current: string) {
    const next = current === 'dark' ? 'light' : 'dark';
    button?.setAttribute('aria-label', `Ativar tema ${next}`);
    button?.setAttribute('title', `Ativar tema ${next}`);
    button?.classList.toggle('theme-dark', current === 'dark');
  }

  button?.addEventListener('click', () => {
    const current =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = current;
    localStorage.setItem('theme', current);
    sync(current);
  });

  sync(document.documentElement.dataset.theme ?? 'light');
</script>

<style>
  .theme-toggle svg {
    display: none;
  }

  /* No tema escuro mostramos o sol, no claro a lua */
  .theme-toggle.theme-dark svg:first-child,
  .theme-toggle:not(.theme-dark) svg:last-child {
    display: block;
  }
</style>