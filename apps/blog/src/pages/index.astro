---
// Página inicial: apresentação + conteúdo recente.
// Aqui reunimos os dados das três coleções para montar uma visão
// geral do arquivo.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { withBase } from '../lib/paths';

// Filtra rascunhos: posts com `draft: true` nunca devem aparecer
// no site público.
const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const notes = await getCollection('notes');

const recentPosts = posts.slice(0, 5);
const recentProjects = projects.slice(0, 4);
const recentNotes = notes.slice(0, 5);
---

<BaseLayout
  title="Início"
  description="Arquivo pessoal: coisas que estou aprendendo, construindo e tentando entender."
>
  <section class="container hero">
    <h1>Olá, eu sou o Alison.</h1>
    <p>
      Estudante de engenharia da computação com muitos projetos para se
      concentrar em apenas um. Este é o meu canto na internet — um arquivo
      das coisas que estou aprendendo, construindo e tentando entender.
    </p>

    <div class="now">
      <h2>Agora</h2>
      <ul>
        <li>→ [o que você está fazendo agora]</li>
      </ul>
    </div>
  </section>

  <div class="container">
    <section class="section">
      <h2 class="section-title">
        Posts recentes
        <span class="more"><a href={withBase('/posts')}>ver todos →</a></span>
      </h2>
      <EntryList entries={recentPosts} />
    </section>

    <section class="section">
      <h2 class="section-title">
        Projetos
        <span class="more"><a href={withBase('/projects')}>ver todos →</a></span>
      </h2>
      <EntryList entries={recentProjects} />
    </section>

    <section class="section">
      <h2 class="section-title">
        Notas
        <span class="more"><a href={withBase('/notes')}>ver todas →</a></span>
      </h2>
      <EntryList entries={recentNotes} />
    </section>
  </div>
</BaseLayout>