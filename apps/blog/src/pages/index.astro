---
// Página inicial: apresentação + posts recentes.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { withBase } from '../lib/paths';

// Filtra rascunhos: posts com `draft: true` nunca devem aparecer
// no site público.
const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const recentPosts = posts.slice(0, 5);
---

<BaseLayout
  title="Início"
  description="Alison · estudante de engenharia da computação. Arquivo de coisas que estou aprendendo, construindo e tentando entender."
>
  <section class="container hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-greeting">Olá, eu sou o Alison</p>
        <p class="hero-bio">
          Um estudante de engenharia de computação com muitos projetos ao mesmo tempo para administrar.
        </p>

        <div class="now">
          <h2>Agora</h2>
          <ul>
            <li>→ Provavelmente mestrando um RPG ou fazendo um projeto besta</li>
          </ul>
        </div>
      </div>

      <div class="hero-photo">
        <img src={withBase('/perfil.png')} alt="Foto de Alison" />
      </div>
    </div>
  </section>

  <div class="container">
    <section class="section">
      <h2 class="section-title">
        Posts recentes
        <span class="more"><a href={withBase('/posts')}>ver todos →</a></span>
      </h2>
      <EntryList entries={recentPosts} />
    </section>
  </div>
</BaseLayout>
