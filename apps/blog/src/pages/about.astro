---
// Página "Sobre": quem sou e o que é este arquivo.
// Conteúdo com placeholders — preencha com suas informações reais.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sobre"
  description="Sobre mim e sobre este arquivo pessoal."
>
  <section class="container post-header">
    <h1>Sobre</h1>
  </section>

  <section class="container post-body">
    <div class="prose">
      <p class="about-first">
        "Don't you dare go hollow."
      </p>

      <p>
        O que você encontra aqui é um registro público das minhas coisinhas.
        Desde meus desenvolvimentos de software até ramblings aleatórios,
      </p>

      <h2>Como este site funciona</h2>
      <p>
        Todo o conteúdo vive como arquivos Markdown versionados no Git.
        Escrevo usando uma ferramenta própria (o Writer) eo GitHub Actions reconstrói o site
        automaticamente.
      </p>

      <h2>Contato</h2>
      <p>
        Você pode me encontrar em:
      </p>
      <ul>
        <li><a href="https://github.com/ABMS-NS" rel="noopener" target="_blank">GitHub profissional</a></li>
        <li><a href="https://github.com/molinete-magico" rel="noopener" target="_blank">GitHub pessoal</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
